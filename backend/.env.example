# Copy to backend/.env and fill in. Never commit .env.

# true -> no LLM calls at all; the deterministic engine explains recommendations (offline-safe demo)
USE_MOCKS=false

# OpenAI (required by the hackathon rules)
OPENAI_API_KEY=
# gpt-6-luna = fast/cheap tier for the product (runtime must answer < 10 s). Not Astra: too slow for runtime.
OPENAI_MODEL=gpt-6-luna
# gpt-6-luna / gpt-6-sol: none|low|medium|high · gpt-5-mini: minimal|low|medium|high · EMPTY for gpt-4.1-mini
OPENAI_REASONING_EFFORT=none
# total LLM budget per recommendation, seconds (ТЗ: <= 10 s end-to-end)
LLM_TIMEOUT_S=9
# single: one structured call; tools: two Responses API rounds within the same deadline
AGENT_MODE=single

# Optional fallback provider, OpenAI-compatible (NVIDIA NIM)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_MODEL=meta/llama-3.3-70b-instruct

# Optional overrides
# DATA_DIR=../data/career_quest
# FRONTEND_DIST=../frontend/dist
